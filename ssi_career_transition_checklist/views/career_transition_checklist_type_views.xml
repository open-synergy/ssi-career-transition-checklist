<odoo>
    <record id="career_transition_checklist_type_view_search" model="ir.ui.view">
        <field name="name">career_transition_checklist_type - search</field>
        <field name="model">career_transition_checklist_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="career_transition_checklist_type_view_tree" model="ir.ui.view">
        <field name="name">career_transition_checklist_type - tree</field>
        <field name="model">career_transition_checklist_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="career_transition_checklist_type_view_form" model="ir.ui.view">
        <field name="name">career_transition_checklist_type - form</field>
        <field name="model">career_transition_checklist_type</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//sheet" position="before">
                    <header>
                        <button
                            name="action_create_cron"
                            type="object"
                            string="Create Cron"
                            attrs="{'invisible': [('cron_id', '!=', False)]}"
                        />
                        <button
                            name="action_delete_cron"
                            type="object"
                            string="Delete Cron"
                            attrs="{'invisible': [('cron_id', '=', False)]}"
                            confirm="Delete scheduled action for this type?"
                        />
                    </header>
                </xpath>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="checklist_items" string="Checklist Items">
                        <field name="checklist_item_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="checklist_method" />
                                <field
                                    name="python_code"
                                    attrs="{'invisible':[('checklist_method','!=','automatic')]}"
                                />
                            </tree>
                        </field>
                        <group name="checklist_type_filter" colspan="4" col="2">
                            <group name="checklist_type_filter_1" colspan="2" col="2">
                                <field
                                    name="career_transition_type_ids"
                                    widget="many2many_tags"
                                />
                            </group>
                            <group name="cron_info" colspan="2" col="2">
                                <field name="cron_id" readonly="1" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="career_transition_checklist_type_action" model="ir.actions.act_window">
        <field name="name">Career Transition Checklist Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">career_transition_checklist_type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="career_transition_checklist_type_menu"
        name="Career Transition Checklist Types"
        parent="ssi_hr.menu_career_configuration"
        action="career_transition_checklist_type_action"
        groups="career_transition_checklist_type_group"
        sequence="30"
    />
</odoo>
