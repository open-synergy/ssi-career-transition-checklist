<odoo>
    <!-- Rule 1: Internal user -->
    <record
        id="career_transition_checklist_internal_user_rule"
        model="ir.rule"
    >
        <field name="name">Career Transition Checklist - Internal Users</field>
        <field name="model_id" ref="model_career_transition_checklist" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field
            name="domain_force"
        >['|',('user_id','=',user.id),('employee_id','=',user.employee_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- Rule 2: Direct subordinate -->
    <record
        id="career_transition_checklist_direct_subordinate_rule"
        model="ir.rule"
    >
        <field
            name="name"
        >Career Transition Checklist - Responsible to direct subordinate data</field>
        <field name="model_id" ref="model_career_transition_checklist" />
        <field
            name="groups"
            eval="[(4, ref('career_transition_checklist_subordinate_group'))]"
        />
        <field
            name="domain_force"
        >[('employee_id.parent_id','=',user.employee_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- Rule 3: All subordinate -->
    <record
        id="career_transition_checklist_all_subordinate_rule"
        model="ir.rule"
    >
        <field
            name="name"
        >Career Transition Checklist - Responsible to all subordinate data</field>
        <field name="model_id" ref="model_career_transition_checklist" />
        <field
            name="groups"
            eval="[(4, ref('career_transition_checklist_all_subordinate_group'))]"
        />
        <field
            name="domain_force"
        >[('employee_id','child_of',user.employee_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- Rule 4: Company -->
    <record
        id="career_transition_checklist_company_rule"
        model="ir.rule"
    >
        <field
            name="name"
        >Career Transition Checklist - Responsible to company data</field>
        <field name="model_id" ref="model_career_transition_checklist" />
        <field
            name="groups"
            eval="[(4, ref('career_transition_checklist_company_group'))]"
        />
        <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- Rule 5: Company and All Child Companies -->
    <record
        id="career_transition_checklist_companies_rule"
        model="ir.rule"
    >
        <field
            name="name"
        >Career Transition Checklist - Responsible to company and all child companies data</field>
        <field name="model_id" ref="model_career_transition_checklist" />
        <field
            name="groups"
            eval="[(4, ref('career_transition_checklist_company_child_group'))]"
        />
        <field
            name="domain_force"
        >[('company_id','in',user.company_ids.ids)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- Rule 6: All data -->
    <record
        id="career_transition_checklist_all_rule"
        model="ir.rule"
    >
        <field name="name">Career Transition Checklist - All</field>
        <field name="model_id" ref="model_career_transition_checklist" />
        <field
            name="groups"
            eval="[(4, ref('career_transition_checklist_all_group'))]"
        />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
