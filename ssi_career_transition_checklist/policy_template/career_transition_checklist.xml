<odoo noupdate="1">
    <record
        id="career_transition_checklist_policy_template"
        model="policy.template"
    >
        <field name="name">Standard</field>
        <field name="model_id" ref="model_career_transition_checklist" />
        <field
            name="state_field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','state')]"
        />
        <field name="sequence" eval="100" />
        <field name="python_code">result=True</field>
    </record>

    <!-- confirm -->
    <record
        id="career_transition_checklist_policy_template_detail_confirm"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','confirm_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','=','draft')]"
        />
        <field name="restrict_user" eval="1" />
        <field name="computation_method">use_group</field>
        <field
            name="group_ids"
            eval="[(6,0,[ref('career_transition_checklist_user_group')])]"
        />
        <field name="restrict_additional" eval="0" />
    </record>

    <!-- approve -->
    <record
        id="career_transition_checklist_policy_template_detail_approve"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','approve_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','=','confirm')]"
        />
        <field name="restrict_user" eval="0" />
        <field name="restrict_additional" eval="1" />
        <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
    </record>

    <!-- reject -->
    <record
        id="career_transition_checklist_policy_template_detail_reject"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','reject_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','=','confirm')]"
        />
        <field name="restrict_user" eval="0" />
        <field name="restrict_additional" eval="1" />
        <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
    </record>

    <!-- restart approval -->
    <record
        id="career_transition_checklist_policy_template_detail_restart_approval"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','restart_approval_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','=','confirm')]"
        />
        <field name="restrict_user" eval="1" />
        <field name="computation_method">use_group</field>
        <field
            name="group_ids"
            eval="[(6,0,[ref('career_transition_checklist_validator_group')])]"
        />
        <field name="restrict_additional" eval="1" />
        <field name="additional_python_code">result = False
if not document.approval_template_id:
    result = True</field>
    </record>

    <!-- done -->
    <record
        id="career_transition_checklist_policy_template_detail_done"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','done_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','=','open')]"
        />
        <field name="restrict_user" eval="1" />
        <field name="computation_method">use_group</field>
        <field
            name="group_ids"
            eval="[(6,0,[ref('career_transition_checklist_user_group')])]"
        />
        <field name="restrict_additional" eval="0" />
    </record>

    <!-- cancel -->
    <record
        id="career_transition_checklist_policy_template_detail_cancel"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','cancel_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','in',['draft','confirm','open'])]"
        />
        <field name="restrict_user" eval="1" />
        <field name="computation_method">use_group</field>
        <field
            name="group_ids"
            eval="[(6,0,[ref('career_transition_checklist_validator_group')])]"
        />
        <field name="restrict_additional" eval="0" />
    </record>

    <!-- restart -->
    <record
        id="career_transition_checklist_policy_template_detail_restart"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','restart_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','in',['cancel','reject'])]"
        />
        <field name="restrict_user" eval="1" />
        <field name="computation_method">use_group</field>
        <field
            name="group_ids"
            eval="[(6,0,[ref('career_transition_checklist_validator_group')])]"
        />
        <field name="restrict_additional" eval="0" />
    </record>

    <!-- manual number -->
    <record
        id="career_transition_checklist_policy_template_detail_manual_number"
        model="policy.template_detail"
    >
        <field
            name="template_id"
            ref="career_transition_checklist_policy_template"
        />
        <field
            name="field_id"
            search="[('model_id.model','=','career_transition_checklist'),('name','=','manual_number_ok')]"
        />
        <field name="restrict_state" eval="1" />
        <field
            name="state_ids"
            search="[('field_id.model_id.model','=','career_transition_checklist'),('value','=','draft')]"
        />
        <field name="restrict_user" eval="1" />
        <field name="computation_method">use_group</field>
        <field
            name="group_ids"
            eval="[(6,0,[ref('career_transition_checklist_validator_group')])]"
        />
        <field name="restrict_additional" eval="0" />
    </record>
</odoo>
